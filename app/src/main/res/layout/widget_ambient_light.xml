<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_frame"
    android:padding="10dp"
    android:clickable="false">

    <TextView
        android:id="@+id/ambientTopText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Подсветка"
        android:textColor="@color/widget_label_text"
        android:fontFamily="sans-serif-medium"
        android:textSize="18sp"
        android:maxLines="1" />

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginVertical="4dp">

        <ImageView
            android:id="@+id/ambientCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/climate_circle_off"
            android:focusable="false"
            android:clickable="false"
            android:contentDescription="circle" />

        <ImageView
            android:id="@+id/ambientIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_ambient_off"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="ambient" />
    </FrameLayout>

    <TextView
        android:id="@+id/ambientBottomText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Штатно"
        android:textColor="@color/widget_label_text"
        android:fontFamily="sans-serif-medium"
        android:textSize="16sp"
        android:focusable="true"
        android:clickable="true"
        android:maxLines="1" />

</LinearLayout>
